{
  "ir_version": "1.0",
  "strategy": {
    "id": "bb_revert_sol",
    "name": "Bollinger revert",
    "description": "Enter long when close crosses below the lower band. Exit when close crosses above the middle band."
  },
  "engine": {
    "bar_size": "1h",
    "event": "bar_close",
    "fill_price_mode": "on_close",
    "warmup_bars": 20
  },
  "capital": {
    "initial": 10000,
    "currency": "USDC"
  },
  "costs": {
    "commission_bps": 10,
    "slippage_bps": 5
  },
  "assets": [
    {
      "id": "sol",
      "symbol": "SOL",
      "chain": "solana",
      "market": "spot",
      "quote": "USDC"
    }
  ],
  "derived_series": [
    {
      "id": "bb_lower",
      "kind": "indicator",
      "indicator": "bollinger",
      "source": "close",
      "params": { "period": 20, "stddev": 2 },
      "output": "lower"
    },
    {
      "id": "bb_middle",
      "kind": "indicator",
      "indicator": "bollinger",
      "source": "close",
      "params": { "period": 20, "stddev": 2 },
      "output": "middle"
    }
  ],
  "signals": [
    {
      "id": "revert_buy",
      "expr": {
        "op": "cross_below",
        "args": [
          { "op": "ref", "name": "close" },
          { "op": "ref", "name": "bb_lower" }
        ]
      }
    },
    {
      "id": "revert_exit",
      "expr": {
        "op": "cross_above",
        "args": [
          { "op": "ref", "name": "close" },
          { "op": "ref", "name": "bb_middle" }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "enter_sol",
      "type": "enter",
      "side": "long",
      "asset": "sol",
      "order": { "type": "market" },
      "sizing": { "mode": "percent_equity", "percent": 20 },
      "risk": {
        "type": "oco",
        "evaluation": "on_entry_fill",
        "movement": "tighten_only",
        "take_profit": { "mode": "percent", "percent": 4 },
        "stop_loss": { "mode": "percent", "percent": 2 }
      }
    },
    {
      "id": "exit_sol",
      "type": "exit",
      "side": "long",
      "asset": "sol",
      "order": { "type": "market" },
      "sizing": { "mode": "percent_position", "percent": 100 }
    }
  ],
  "rules": [
    { "id": "enter_on_lower_cross", "when": "revert_buy", "do": "enter_sol" },
    { "id": "exit_on_middle_cross", "when": "revert_exit", "do": "exit_sol" }
  ],
  "portfolio": {
    "mode": "spot",
    "direction": "long_only",
    "chain": "solana",
    "max_positions": 1,
    "allow_pyramiding": false,
    "quote_currency": "USDC"
  }
}
