# tradoortest local runtime
# Single-user. This file intentionally has no values.
# Do not put secrets, private keys, API tokens, or wallet material here.

# Optional directory for the local OHLCV SQLite cache (ohlcv.sqlite).
# Defaults to ./data, which is gitignored. The GeckoTerminal adapter does
# not read an API key.
# OHLCV_DATA_DIR=

# Optional cache lifetime in hours. Maximum 24. Above that is rejected.
# Default is 24. The CoinGecko API terms do not allow a longer store.
# OHLCV_CACHE_TTL_HOURS=

# Optional Birdeye fallback. Unset means the fallback is off.
# The key is read from the environment only. Do not write a value here.
# BIRDEYE_API_KEY=

# Optional Birdeye compute-unit budget. Default 30000. A month that
# cannot pay for the next call fails before the request.
# BIRDEYE_CU_BUDGET=

# Optional cap on GeckoTerminal HTTP calls for one any-mint ingest. Default 180.
# The API reads this too. The counter resets at the start of each ingest.
# OHLCV_GT_MAX_CALLS=

# Optional cap on mints in one POST /ohlcv/jobs body. Default 8.
# Counted before duplicates are removed.
# OHLCV_MAX_MINTS=

# Optional maximum POST body size in bytes. Default 16384.
# OHLCV_MAX_BODY_BYTES=

# Optional live paper-bar scheduler. Unset or 0 means off. It fetches closed
# bars, stores them, then runs the paper broker. It does not send orders.
# See docs/live-feed.md and docs/paper.md.
# LIVE_FEED_ENABLED=

# Live trading. The only on value is 1. Unset, blank, and any other value
# are off, and submit fails closed. The server never signs. A browser
# wallet signs POST /live/prepare's unsigned transaction, then POST
# /live/confirm submits it. See docs/live.md.
# LIVE_TRADING_ENABLED=

# Public address of the wallet that must sign. Not a key. Unset rejects
# prepare and confirm. Do not write a value here.
# LIVE_WALLET_PUBKEY=

# Kill file. Read at the top of every tick without the API, the DB, or a
# token. The only clear contents are 0. Missing or unreadable halts.
# Do not put a secret in the file. POST /live/kill writes 1.
# LIVE_KILL_FILE=

# Optional. The exact value 1 halts, the same way an unreadable kill file does.
# LIVE_KILL=

# Header token for POST /live/kill, /live/flatten, /live/submit, /live/prepare,
# and /live/confirm. Unset rejects those routes. Do not write a value here.
# CI does not set this. The web proxy reads it on the server and does not
# send it to the browser.
# LIVE_CONTROL_TOKEN=

# Bind address. Unset means 127.0.0.1. Any other value except localhost and
# ::1 refuses to start. The server stays on loopback.
# HOST=

# Optional Solana JSON-RPC URL for block height, lookup tables, and
# pre-sign simulation. Unset means those reads are skipped or rejected.
# Tests use a mock. Do not put a key in the URL.
# SOLANA_RPC_URL=

# Optional Jupiter Swap API key. Sent only as the x-api-key header.
# Unset means a keyless quote. Do not write a value here. CI does not set this.
# JUPITER_API_KEY=

# Quote-only shadow mode. The only on value is 1. Unset and any other value
# are off. It asks the venue for a quote next to a paper fill. It does not
# sign or send. See docs/paper.md.
# SHADOW_QUOTES_ENABLED=

# Optional unsigned /build after a shadow quote, to count amount_mismatch.
# The only on value is 1. Transaction bytes are not stored.
# SHADOW_BUILD_ENABLED=

# slippageBps sent on /order and /build. Blank keeps 50. This is the request
# parameter, not the P4-04 risk cap.
# SHADOW_SLIPPAGE_BPS=

# Optional taker address for the unsigned shadow build. Unset skips the build.
# A public address only. Do not write a key here.
# SHADOW_TAKER=

# Shadow quote timeout in seconds. Blank keeps 2. The tick does not wait.
# SHADOW_QUOTE_TIMEOUT_SECONDS=

# Shadow quote backlog. Blank keeps 4. A full queue drops the quote.
# SHADOW_QUOTE_BACKLOG=

# Minimum seconds between Jupiter HTTP attempts. Blank keeps 1.
# JUPITER_MIN_INTERVAL_SECONDS=

# Jupiter HTTP attempts allowed on one calendar day. Blank keeps 1000.
# The day key moves forward only.
# JUPITER_DAILY_CAP=

# Optional cap on running paper strategy versions. Default 3. Integer from 1 to 100.
# A deploy past the cap is HTTP 409 paper_limit. See docs/paper.md.
# PAPER_MAX_RUNNING=

# Optional absolute quote delta that flags backtest-versus-paper drift.
# Default 0.01. A number from 0 to 1000000 with at most 8 decimal places.
# The report is computed on read and is not stored. See docs/paper.md.
# PAPER_DRIFT_THRESHOLD=

# Optional path to the strategy SQLite file. Default ./data/strategies.sqlite,
# which is gitignored. Rows store DSL and canonical IR for the local user.
# They do not store OHLCV bars or backtest market data.
# STRATEGIES_DB_PATH=

# Optional maximum strategy request body in bytes. Default 65536.
# Allowed range is 1 to 1048576. Declared Content-Length and chunked
# bodies without Content-Length are both capped.
# STRATEGIES_MAX_BODY_BYTES=

# Optional SQLite busy timeout in milliseconds for the strategy file.
# Default 5000. Allowed range is 0 to 60000.
# STRATEGIES_BUSY_TIMEOUT_MS=

# Optional path to the author-agent SQLite file. Default ./data/agent.sqlite,
# which is gitignored. It stores the transcript and proposals for the local
# user. It does not store OHLCV bars, backtest results, or pool snapshots.
# AGENT_DB_PATH=

# Optional maximum agent request body in bytes. Default 65536.
# Allowed range is 1 to 1048576. Declared Content-Length and chunked
# bodies without Content-Length are both capped.
# AGENT_MAX_BODY_BYTES=

# Optional SQLite busy timeout in milliseconds for the agent file.
# Default 5000. Allowed range is 0 to 60000.
# AGENT_BUSY_TIMEOUT_MS=

# Optional default session tier: fast, balanced, or max. Default balanced.
# AGENT_DEFAULT_TIER=

# Optional model provider: stub, openai_compatible, or anthropic.
# Default stub, which does not open a socket. Per-tier overrides:
# AGENT_PROVIDER=
# AGENT_PROVIDER_FAST=
# AGENT_PROVIDER_BALANCED=
# AGENT_PROVIDER_MAX=

# Optional base URL for openai_compatible or anthropic. No userinfo, query,
# or fragment. Per-tier overrides use the same rule.
# AGENT_BASE_URL=
# AGENT_BASE_URL_FAST=
# AGENT_BASE_URL_BALANCED=
# AGENT_BASE_URL_MAX=

# Optional model name for each tier. Default is the tier name.
# AGENT_MODEL_FAST=
# AGENT_MODEL_BALANCED=
# AGENT_MODEL_MAX=

# Optional API keys. Read from the environment only. Do not write a value.
# AGENT_API_KEY is checked first. ANTHROPIC_API_KEY is the Anthropic fallback.
# OPENAI_API_KEY and XAI_API_KEY are the OpenAI-compatible fallbacks.
# AGENT_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=

# Optional origin of the author API for the Next.js chat proxy in web/.
# Read on the server only. The browser calls /api/agent and never sees this
# value. No NEXT_PUBLIC_ name. Leave it commented. Do not put a secret here.
# AGENT_API_ORIGIN=
