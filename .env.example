# tradoortest local runtime
# Single-user. This file intentionally has no values.
# Do not put secrets, private keys, API tokens, or wallet material here.

# Optional directory for the local OHLCV SQLite cache (ohlcv.sqlite).
# Defaults to ./data, which is gitignored. The GeckoTerminal adapter does
# not read an API key.
# OHLCV_DATA_DIR=

# Optional cache lifetime in hours. Maximum 24. Above that is rejected.
# Default is 24. The CoinGecko API terms do not allow a longer store.
# OHLCV_CACHE_TTL_HOURS=

# Optional Birdeye fallback. Unset means the fallback is off.
# The key is read from the environment only. Do not write a value here.
# BIRDEYE_API_KEY=

# Optional Birdeye compute-unit budget. Default 30000. A month that
# cannot pay for the next call fails before the request.
# BIRDEYE_CU_BUDGET=

# Optional cap on GeckoTerminal HTTP calls for one any-mint ingest. Default 180.
# The API reads this too. The counter resets at the start of each ingest.
# OHLCV_GT_MAX_CALLS=

# Optional cap on mints in one POST /ohlcv/jobs body. Default 8.
# Counted before duplicates are removed.
# OHLCV_MAX_MINTS=

# Optional maximum POST body size in bytes. Default 16384.
# OHLCV_MAX_BODY_BYTES=
